version: 2
ethernets:
{% for nic in vm.nics %}
{% set net = libvirt_networks | selectattr('name', 'equalto', nic.network) | first %}
  nic{{ loop.index0 }}:
    match:
      macaddress: "{{ nic.mac }}"
    addresses:
      - {{ nic.address }}/{{ net.prefix }}
{% if nic.gateway %}
    routes:
      - to: default
        via: {{ net.address }}
    nameservers:
      addresses:
        - {{ net.address }}
{% endif %}
{% endfor %}
