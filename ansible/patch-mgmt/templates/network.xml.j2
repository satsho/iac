<!-- {{ ansible_managed | default('Managed by ansible/patch-mgmt') }} -->
<network xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'>
  <name>{{ net.name }}</name>
{% if existing_uuid | default('') | length > 0 %}
  <uuid>{{ existing_uuid }}</uuid>
{% endif %}
{% if net.forward == 'nat' %}
  <forward mode='nat'/>
{% endif %}
  <bridge name='{{ net.bridge }}' stp='on' delay='0'/>
  <ip address='{{ net.address }}' netmask='{{ net.netmask }}'>
    <dhcp>
      <range start='{{ net.dhcp_range[0] }}' end='{{ net.dhcp_range[1] }}'/>
      <!-- VMのIPはMACアドレスで固定する(ISOからのインストールなのでVM側では固定しない) -->
{% for vm in vms %}
{% for nic in vm.nics if nic.network == net.name %}
      <host mac='{{ nic.mac }}' name='{{ vm.name }}' ip='{{ nic.address }}'/>
{% endfor %}
{% endfor %}
    </dhcp>
  </ip>
  <dnsmasq:options>
    <!-- dnsmasq 2.90の--bind-dynamicのバグ対策: 本来このネットワークのブリッジだけに
         バインドすべきところ、ホストの全インターフェースを掴んでしまうことがあり、
         ホストのLAN側DHCP(kea-dhcp4)とポート67を取り合って起動に失敗する。
         LAN側インターフェースを明示的に除外する。 -->
    <dnsmasq:option value='except-interface={{ host_lan_interface }}'/>
{% if net.egress_firewall | default(false) %}
    <!-- 仮想FW: 許可ドメインを名前解決した結果のIPを、KVMホストのnftablesの許可リスト(set)に入れる -->
    <dnsmasq:option value='nftset=/{{ workload_egress_allowlist.https | join('/') }}/4#inet#{{ workload_egress_firewall_table }}#https_v4'/>
    <dnsmasq:option value='nftset=/{{ workload_egress_allowlist.ntp | join('/') }}/4#inet#{{ workload_egress_firewall_table }}#ntp_v4'/>
{% endif %}
  </dnsmasq:options>
</network>
