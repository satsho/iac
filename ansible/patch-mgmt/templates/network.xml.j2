<!-- {{ ansible_managed | default('Managed by ansible/patch-mgmt') }} -->
<network>
  <name>{{ net.name }}</name>
  <uuid>{{ net_uuid }}</uuid>
{% if net.forward == 'nat' %}
  <forward mode='nat'/>
{% endif %}
  <bridge name='{{ net.bridge }}' stp='on' delay='0'/>
  <!-- DHCPは使わない(VMのIPはディスクに書き込んで固定する。kvm-finish.yml) -->
{% if net.egress_firewall | default(false) %}
  <!-- 名前解決はlibvirtのdnsmasqではなく、仮想FWの許可リストを作るDNSサーバ(patch-mgmt-dns.service)が行う -->
  <dns enable='no'/>
{% else %}
  <!-- libvirtのdnsmasqは名前解決だけを行う -->
  <dns>
{% for vm in vms %}
{% for nic in vm.nics if nic.network == net.name %}
    <host ip='{{ nic.address }}'>
      <hostname>{{ vm.name }}</hostname>
    </host>
{% endfor %}
{% endfor %}
  </dns>
{% endif %}
  <ip address='{{ net.address }}' prefix='{{ net.prefix }}'/>
</network>
