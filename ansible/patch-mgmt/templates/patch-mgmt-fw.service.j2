# {{ ansible_managed }}
[Unit]
Description=Egress firewall for the patch-mgmt workload network
# dnsmasq(libvirtのネットワーク)がsetにIPを入れる前に、テーブルを作っておく
Before=virtnetworkd.service libvirtd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables/patch-mgmt-fw.nft
ExecStop=/usr/sbin/nft delete table inet {{ workload_egress_firewall_table }}

[Install]
WantedBy=multi-user.target
