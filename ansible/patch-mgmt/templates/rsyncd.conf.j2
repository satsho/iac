# {{ ansible_managed }}
# infraからのミラー同期専用。読み取り専用で、infraのIPからのみ許可する
uid = nobody
gid = nobody
use chroot = yes
read only = yes
max connections = 4
log file = /var/log/rsyncd.log

[rhel]
path = /var/www/html/repos/rhel
comment = Red Hat CDN mirror (reposync)
hosts allow = {{ infra_mgmt_ip }}
hosts deny = *
