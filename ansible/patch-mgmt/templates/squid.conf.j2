# {{ ansible_managed }}
# 業務VM(test/stg/prod)専用のフォワードプロキシ。業務VMが外に出られるのはここだけ。
# 通すのはSSM(Fleet Manager/Run Command/Patch Manager)・CloudWatch Logs・
# S3(SSM Agent本体とパッチ処理用ファイル)・RHSMの登録だけで、Red Hat CDN(cdn.redhat.com)
# などは拒否する。拒否した通信は access.log に TCP_DENIED として残る。
http_port {{ proxy_port }}

acl workload_net src {{ workload_cidr }}
acl SSL_ports port 443
acl CONNECT method CONNECT
acl allowed_hosts dstdomain ssm.{{ aws_region }}.amazonaws.com
acl allowed_hosts dstdomain ssmmessages.{{ aws_region }}.amazonaws.com
acl allowed_hosts dstdomain ec2messages.{{ aws_region }}.amazonaws.com
acl allowed_hosts dstdomain logs.{{ aws_region }}.amazonaws.com
acl allowed_hosts dstdomain .s3.{{ aws_region }}.amazonaws.com
acl allowed_hosts dstdomain subscription.rhsm.redhat.com

http_access deny CONNECT !SSL_ports
http_access allow workload_net allowed_hosts
http_access deny all

cache deny all
access_log daemon:/var/log/squid/access.log squid
coredump_dir /var/spool/squid
