#!/usr/bin/python3
# {{ ansible_managed }}
# 全VM(SSM管理下)のインストール済みパッケージ一覧(SSM Inventory)を読み、
# CycloneDX SBOMを組み立ててtrivyでスキャンし、結果をS3へ書き出す
# (patch-trivy-scan.timer から毎日実行)。
#
# SSM InventoryのRaw データ(Resource Data SyncでS3へ同期済み)ではなく、
# SSM Inventory APIを直接叩く。Parquet/JSONSerDeの中間ファイルを解析するより
# 単純で、スキャン実行時点の最新の状態を確実に取れるため。
import datetime
import json
import subprocess
import sys
import tempfile
from pathlib import Path

REGION = "{{ aws_region }}"
BUCKET = "{{ inventory_bucket }}"
# RHELのメジャーバージョン(SBOMのmetadata.componentに設定する。trivyはここを見て
# どの脆弱性DB(Red Hatのアドバイザリ)と照合するかを決める。purlだけでは不十分)。
RHEL_VERSION = "{{ rhel_release if rhel_release | length > 0 else '10' }}"


def run_aws(*args):
    out = subprocess.run(["aws", "--region", REGION, "--output", "json", *args], capture_output=True, text=True, check=True)
    return json.loads(out.stdout) if out.stdout.strip() else {}


def list_instances():
    data = run_aws("ssm", "describe-instance-information")
    return [i["InstanceId"] for i in data.get("InstanceInformationList", []) if i.get("PlatformType") == "Linux"]


def inventory_entries(instance_id):
    entries = []
    kwargs = {}
    while True:
        args = ["ssm", "list-inventory-entries", "--instance-id", instance_id, "--type-name", "AWS:Application"]
        if "NextToken" in kwargs:
            args += ["--next-token", kwargs["NextToken"]]
        data = run_aws(*args)
        entries += data.get("Entries", [])
        if not data.get("NextToken"):
            break
        kwargs["NextToken"] = data["NextToken"]
    return entries


def build_sbom(instance_id, entries):
    components = []
    for e in entries:
        name = e.get("Name")
        version = e.get("Version")
        arch = e.get("Architecture")
        # gpg-pubkeyなどはrpmパッケージではない(Architectureが"(none)"、Versionが
        # 実体は鍵ID)ので除外する
        if not name or not version or not arch or arch == "(none)":
            continue
        purl = f"pkg:rpm/redhat/{name}@{version}?arch={arch}"
        components.append(
            {
                "type": "library",
                "name": name,
                "version": version,
                "purl": purl,
            }
        )
    return {
        "bomFormat": "CycloneDX",
        "specVersion": "1.4",
        "serialNumber": f"urn:uuid:{instance_id}-{datetime.date.today().isoformat()}",
        "version": 1,
        "metadata": {
            # trivyがRed Hatのアドバイザリと照合するために必須(RPM由来のSBOMには
            # OS情報が無いため、trivy公式ドキュメントの手順通り手動で設定する)。
            "component": {"type": "operating-system", "name": "redhat", "version": RHEL_VERSION}
        },
        "components": components,
    }


def scan(sbom_path):
    out = subprocess.run(
        ["trivy", "sbom", "--format", "json", "--quiet", str(sbom_path)],
        capture_output=True,
        text=True,
    )
    if out.returncode not in (0, 1):  # trivyは脆弱性を見つけると終了コード1を返す設定もあるため両方許容
        print(out.stderr, file=sys.stderr)
        out.check_returncode()
    return json.loads(out.stdout) if out.stdout.strip() else {}


def upload(key, body):
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        json.dump(body, f)
        path = f.name
    subprocess.run(["aws", "--region", REGION, "s3", "cp", path, f"s3://{BUCKET}/{key}"], check=True)
    Path(path).unlink()


def main():
    today = datetime.date.today().isoformat()
    instances = list_instances()
    print(f"{len(instances)} instance(s) found")

    for instance_id in instances:
        entries = inventory_entries(instance_id)
        if not entries:
            print(f"{instance_id}: no inventory yet, skipping")
            continue

        sbom = build_sbom(instance_id, entries)
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
            json.dump(sbom, f)
            sbom_path = Path(f.name)

        try:
            result = scan(sbom_path)
        finally:
            sbom_path.unlink()

        vulns = [v for r in result.get("Results", []) for v in r.get("Vulnerabilities", []) or []]
        record = {
            "instance_id": instance_id,
            "scan_date": today,
            "vulnerability_count": len(vulns),
            "vulnerabilities": vulns,
        }
        upload(f"trivy-results/dt={today}/{instance_id}.json", record)
        print(f"{instance_id}: {len(vulns)} vulnerabilities")


if __name__ == "__main__":
    main()
