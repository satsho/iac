# ---- Red Hat CDN(EUS)の利用設定 ----
# KVM上のVMはPAYGではないので、自分のサブスクリプション(activation key)でRHSMに登録する。
set +x  # activation keyをcloud-initのログに残さない
subscription-manager register \
  --org="{{ rhel_org_id }}" \
  --activationkey="{{ rhel_activation_key }}"
set -x

{% if rhel_release | length > 0 %}
subscription-manager release --set="{{ rhel_release }}"
{% else %}
subscription-manager release --unset
{% endif %}
# このサーバ自身のOS更新もreposync対象と同じリポジトリだけにして、業務VMと同じ
# マイナーリリースに揃える。サブスクリプションにEUSが含まれていない場合はここで失敗するので、
# vars.yml の upstream_repos を非EUSのリポジトリIDに切り替える。
subscription-manager repos --disable='*'{% for repo_id in upstream_repos.values() %} --enable={{ repo_id }}{% endfor %}

dnf clean all
