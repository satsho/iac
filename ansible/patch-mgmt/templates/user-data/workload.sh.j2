# ---- 業務VM(test/stg/prod): infraのミラーだけを参照する ----

# 既存のrepo定義はすべて無効にし、infraのミラーだけを有効にする。
# gpgcheckはRed Hatの署名鍵で行うので、ミラーをhttpで配っても改ざんは検出できる。
for repo_file in /etc/yum.repos.d/*.repo; do
  [ -e "$repo_file" ] || continue
  sed -i 's/^enabled[[:space:]]*=[[:space:]]*1/enabled=0/' "$repo_file"
done

cat <<'EOF' > /etc/yum.repos.d/infra-mirror.repo
{% for name, repo_id in upstream_repos.items() %}
[infra-{{ name }}]
name=infra mirror of {{ repo_id }} ({{ release_dir }})
baseurl=http://{{ infra_workload_ip }}/repos/rhel/{{ release_dir }}/{{ name }}/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

{% endfor %}
EOF

# 時刻はinfraに合わせる(外のNTPプールには出られない)
sed -i -E 's/^(pool|server) /#&/' /etc/chrony.conf
echo "server {{ infra_workload_ip }} iburst" >> /etc/chrony.conf
systemctl restart chronyd

# サブスクリプションの利用状況を正しく残すためRHSMには登録する(通信はinfraのプロキシ経由)。
# ただしsubscription-managerにはrepoファイルを管理させず、CDNのリポジトリは使わない。
subscription-manager config \
  --server.proxy_hostname="{{ infra_workload_ip }}" \
  --server.proxy_port="{{ proxy_port }}" \
  --rhsm.manage_repos=0
set +x  # activation keyをcloud-initのログに残さない
subscription-manager register \
  --org="{{ rhel_org_id }}" \
  --activationkey="{{ rhel_activation_key }}"
set -x
