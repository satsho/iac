#!/bin/bash
# Ansible管理(ansible/patch-mgmt/templates/vm-schedule-stop.sh.j2)。手で編集しても次回上書きされる。
#
# 平日夜、稼働中の業務VMだけを正常停止(ACPI shutdown)する(既に停止しているVMには何もしない)。
set -euo pipefail

for vm in {{ scheduled_vm_names | join(' ') }}; do
  state="$(virsh domstate "${vm}" 2>/dev/null || echo 'not found')"
  if [ "${state}" = "running" ]; then
    virsh shutdown "${vm}"
  fi
done
