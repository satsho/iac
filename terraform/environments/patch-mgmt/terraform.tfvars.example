# このファイルをコピーして terraform.tfvars として使う(値はすべて非機密)。

notification_email = "you@example.com"

# --- 例: アプリ単位でメンテナンスウィンドウを分ける -------------------------------
# VM側(ansible/patch-mgmt/vars.yml)に App=app-b のVMを足したうえで、ウィンドウを追加する。
# maintenance_windows = {
#   (デフォルトの test-weekly / stg-weekly / prod-weekly をコピーしたうえで追加する)
#   prod-app-b-sunday = {
#     description   = "prod app-b: 毎週日曜 03:00。app-bはアプリ側の都合で日曜に自動再起動"
#     schedule      = "cron(0 3 ? * SUN *)"
#     target_tags   = { PatchGroup = ["rhel10-prod"], App = ["app-b"] }
#     task_type     = "AUTOMATION"
#     reboot_option = "RebootIfNeeded"
#     gate          = { windows = ["stg-weekly"], patch_groups = ["rhel10-stg"], max_age_hours = 120 }
#   }
# }

# --- 例: 「testで検証した日付」までのパッチだけをprodに流す ---------------------------
# patch_baselines = {
#   test = { approve_after_days = 0 }
#   stg  = { approve_after_days = 1 }
#   prod = { approve_until_date = "2026-10-20" }
#   mgmt = { approve_after_days = 0 }
# }

# --- 緊急で早く当てたい場合は、ここ(variables.tf)を編集するのではなく --------------
# iac-poc-patch-InstallNow(README参照)をAWS CLI/コンソールから実行する。
# approved_patchesはlifecycle.ignore_changesの対象なので、ここに書いても
# 初期値としてしか使われず、以後のapplyでは反映されない(InstallNowがAPIで直接更新する)。

# --- 例: ゲートチェックの動きを素早く確認したい場合(検証用、本番運用では戻すこと) ---
# 承認日数を全部0日にしておくと、承認のタイミングを気にせずゲート(前段の成功確認)の
# 挙動だけに集中して検証できる。test-weekly/stg-weeklyのscheduleを一時的に
# at(2026-01-01T15:00:00)のような一回限りの指定に変えて数分おきに自前で起動すると、
# 定期ウィンドウを待たずにゲートの通過/失敗を確認できる(README「構築手順」参照)。
# patch_baselines = {
#   test = { approve_after_days = 0 }
#   stg  = { approve_after_days = 0 }
#   prod = { approve_after_days = 0 }
#   mgmt = { approve_after_days = 0 }
# }
