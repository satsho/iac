# このファイルをコピーして terraform.tfvars として使う(値はすべて非機密)。
# rhel_ami_id は GitHub Variables の RHEL_AMI_ID から TF_VAR_rhel_ami_id として渡している。

notification_email = "you@example.com"

# 緊急パッチRunbookの承認者のデフォルト
emergency_approvers = ["arn:aws:iam::123456789012:role/your-admin-role"]

# --- 例: アプリ単位でサーバを増やし、メンテナンスウィンドウを分ける -----------------
